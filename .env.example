# TARS Environment Configuration

# Primary LLM API Key (Google Gemini is recommended for fast multi-modal reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default voice speed and pitch
TARS_VOICE=en-US-GuyNeural
TARS_VOICE_RATE=+0%
TARS_VOICE_PITCH=+0Hz

# Execution Mode: text | voice | hybrid
TARS_DEFAULT_MODE=hybrid
